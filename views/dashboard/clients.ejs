<script type="application/json" id="endpoints-data"><%- JSON.stringify(endpoints) %></script>

<div class="row mb">
  <input id="search-users" placeholder="Buscar usuario..." class="input-search" oninput="filterUsers(this.value)">
  <div class="grow"></div>
  <input id="new-user-name" placeholder="Nombre nuevo usuario" class="input-narrow">
  <button class="btn btn-primary btn-sm" onclick="createUser()">+ Agregar</button>
</div>

<div id="user-list">
<% for (const tu of tunnelUsers) { %>
  <div class="card user-card" data-uid="<%= tu._id %>" data-name="<%= tu.name.toLowerCase() %>">
    <div class="row mb">
      <strong class="grow"><%= tu.name %></strong>
      <button class="btn btn-danger btn-sm" onclick="deleteUser('<%= tu._id %>')">Eliminar</button>
    </div>

    <div class="gen-cert-form mb">
      <div class="row gen-cert-row">
        <div class="form-group fg-flex">
          <label>Nombre</label>
          <input id="cert-name-<%= tu._id %>" placeholder="laptop-dev">
        </div>
        <div class="form-group fg-flex">
          <label>Endpoint</label>
          <select id="cert-ep-<%= tu._id %>">
            <option value="">Seleccionar...</option>
            <% for (const ep of endpoints) { %>
              <option value="<%= ep._id %>"><%= ep.name %></option>
            <% } %>
          </select>
        </div>
        <div class="form-group fg-w100">
          <label>Vigencia</label>
          <select id="cert-dur-<%= tu._id %>">
            <option value="60">2 meses</option>
            <option value="120" selected>4 meses</option>
            <option value="180">6 meses</option>
            <option value="240">8 meses</option>
          </select>
        </div>
        <div class="form-group fg-w80">
          <label>↑ KiB</label>
          <input id="cert-limitin-<%= tu._id %>" type="number" min="0" value="10" title="Límite subida en KiB (0 = ilimitado)">
        </div>
        <div class="form-group fg-w80">
          <label>↓ KiB</label>
          <input id="cert-limitout-<%= tu._id %>" type="number" min="0" value="50" title="Límite bajada en KiB (0 = ilimitado)">
        </div>
        <div class="form-group fg-end">
          <button class="btn btn-primary btn-sm" onclick="generateCert('<%= tu._id %>')">Generar</button>
        </div>
      </div>
    </div>

    <div id="ep-certs-<%= tu._id %>"></div>
  </div>
<% } %>
</div>

<!-- Modal editar certificado -->
<div id="modal-edit" class="modal-overlay hidden">
  <div class="modal-box">
    <div class="row mb">
      <strong class="grow">Editar certificado</strong>
      <button class="btn btn-ghost btn-sm" onclick="closeModal('modal-edit')">×</button>
    </div>
    <input type="hidden" id="modal-edit-cert-id">
    <input type="hidden" id="modal-edit-uid">
    <div class="form-group">
      <label>Nombre</label>
      <input id="modal-edit-name">
    </div>
    <div class="row">
      <div class="grow form-group">
        <label>↑ KiB (subida)</label>
        <input id="modal-edit-limitin" type="number" min="0">
      </div>
      <div class="grow form-group">
        <label>↓ KiB (bajada)</label>
        <input id="modal-edit-limitout" type="number" min="0">
      </div>
    </div>
    <button class="btn btn-primary btn-sm" onclick="saveEditCert()">Guardar</button>
  </div>
</div>

<!-- Modal auditoría por certificado -->
<div id="modal-audit" class="modal-overlay hidden">
  <div class="modal-box modal-audit-box">
    <div class="row mb">
      <strong class="grow" id="modal-audit-title">Auditoría</strong>
      <select id="audit-offset" class="audit-offset-select" onchange="reloadAudit()">
        <option value="0">Sin offset</option>
        <option value="1">1 bit</option><option value="2">2 bits</option><option value="3">3 bits</option>
        <option value="4">4 bits</option><option value="5">5 bits</option><option value="6">6 bits</option><option value="7">7 bits</option>
      </select>
      <button class="btn btn-ghost btn-sm" onclick="closeAudit()">×</button>
    </div>
    <div id="audit-logs" class="audit-logs-container"></div>
  </div>
</div>
