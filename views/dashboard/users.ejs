<script type="application/json" id="endpoints-data"><%- JSON.stringify(endpoints) %></script>

<div class="row mb">
  <input id="search-users" placeholder="Buscar usuario..." style="max-width:240px" oninput="filterUsers(this.value)">
  <div class="grow"></div>
  <a href="/api/ca.pem" class="btn btn-ghost btn-sm" download="bastion-ca.pem">⬇ CA</a>
  <input id="new-user-name" placeholder="Nombre nuevo usuario" style="max-width:200px">
  <button class="btn btn-primary btn-sm" onclick="createUser()">+ Agregar</button>
</div>

<div id="user-list">
<% for (const tu of tunnelUsers) { %>
  <div class="card user-card" data-uid="<%= tu._id %>" data-name="<%= tu.name.toLowerCase() %>">
    <div class="row mb">
      <strong class="grow"><%= tu.name %></strong>
      <button class="btn btn-danger btn-sm" onclick="deleteUser('<%= tu._id %>')">Eliminar</button>
    </div>
    <div class="sub-tabs row mb">
      <button class="btn btn-sm btn-primary" onclick="showSub(this,'certs','<%= tu._id %>')">Certificados</button>
      <button class="btn btn-sm btn-ghost" onclick="showSub(this,'access','<%= tu._id %>')">Endpoints</button>
    </div>
    <div id="certs-<%= tu._id %>" class="sub-panel">
      <button class="btn btn-primary btn-sm mb" onclick="openSignCsr('<%= tu._id %>')">+ Firmar CSR</button>
      <div id="cert-list-<%= tu._id %>"></div>
    </div>
    <div id="access-<%= tu._id %>" class="sub-panel hidden">
      <div id="access-list-<%= tu._id %>"></div>
    </div>
  </div>
<% } %>
</div>

<!-- Modal firmar CSR -->
<div id="modal-sign" class="modal-overlay hidden">
  <div class="modal-box">
    <div class="row mb">
      <strong class="grow">Firmar CSR</strong>
      <button class="btn btn-ghost btn-sm" onclick="closeModal('modal-sign')">×</button>
    </div>
    <input type="hidden" id="modal-sign-uid">
    <div class="form-group">
      <label>Nombre</label>
      <input id="modal-sign-name" placeholder="laptop-dev">
    </div>
    <div class="form-group">
      <label>CSR (PEM)</label>
      <textarea id="modal-sign-csr" rows="5" placeholder="-----BEGIN CERTIFICATE REQUEST-----"></textarea>
    </div>
    <button class="btn btn-primary btn-sm" onclick="submitSignCsr()">Firmar</button>
  </div>
</div>

<!-- Modal editar certificado -->
<div id="modal-edit" class="modal-overlay hidden">
  <div class="modal-box">
    <div class="row mb">
      <strong class="grow">Editar certificado</strong>
      <button class="btn btn-ghost btn-sm" onclick="closeModal('modal-edit')">×</button>
    </div>
    <input type="hidden" id="modal-edit-cert-id">
    <div class="form-group">
      <label>Nombre</label>
      <input id="modal-edit-name">
    </div>
    <div class="form-group">
      <label>Nuevo CSR (opcional)</label>
      <textarea id="modal-edit-csr" rows="4" placeholder="-----BEGIN CERTIFICATE REQUEST-----"></textarea>
    </div>
    <button class="btn btn-primary btn-sm" onclick="saveEditCert()">Guardar</button>
  </div>
</div>
