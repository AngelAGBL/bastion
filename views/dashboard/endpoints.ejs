<div class="row mb" style="gap:1rem;align-items:flex-start">
<!-- Endpoint directo -->
<div class="card" style="flex:1">
  <strong class="mb" style="display:block;font-size:.85rem;color:var(--muted)">Endpoint directo</strong>
  <form method="POST" action="/dashboard/endpoints">
    <div class="form-group">
      <label>Nombre</label>
      <input name="name" placeholder="Servidor DB" required>
    </div>
    <div class="row">
      <div class="grow form-group">
        <label>Host</label>
        <input name="host" placeholder="192.168.1.10" required>
      </div>
      <div class="form-group fg-w120">
        <label>Puerto</label>
        <input name="port" type="number" placeholder="5432" required>
      </div>
      <div class="form-group fg-w90">
        <label>Protocolo</label>
        <select name="protocol">
          <option value="tcp" selected>TCP</option>
          <option value="udp">UDP</option>
        </select>
      </div>
    </div>
    <button type="submit" class="btn btn-primary">Crear endpoint</button>
  </form>
</div>

<!-- Endpoint cliente (reverse tunnel) -->
<div class="card" style="flex:1">
  <strong class="mb" style="display:block;font-size:.85rem;color:var(--muted)">Cliente-Endpoint (reverse)</strong>
  <div class="form-group">
    <label>Nombre</label>
    <input id="ep-client-name" placeholder="Mi servidor local">
  </div>
  <button class="btn btn-primary" onclick="createEpClient()">Crear cliente-endpoint</button>
</div>
</div>

<div class="endpoints-grid">
<% for (const ep of endpoints) { %>
<div class="card ep-card-no-mb" id="ep-<%= ep._id %>">
  <div class="row mb">
    <% const isOnline = epClients && epClients[String(ep._id)]; %>
    <span class="ep-status-dot" id="ep-dot-<%= ep._id %>" style="width:8px;height:8px;border-radius:50%;background:<%= isOnline ? 'var(--success)' : 'var(--border)' %>;flex-shrink:0"></span>
    <strong class="grow" id="ep-name-<%= ep._id %>"><%= ep.name %></strong>
    <% if (ep.virtual) { %>
      <span class="badge" style="background:var(--primary);color:#fff">REVERSE</span>
      <button class="btn btn-ghost btn-sm" onclick="downloadEpP12('<%= ep._id %>')">⬇ .p12</button>
    <% } else { %>
      <span class="badge" id="ep-proto-<%= ep._id %>"><%= (ep.protocol || 'tcp').toUpperCase() %></span>
      <button class="btn btn-ghost btn-sm" onclick="openEditEp('<%= ep._id %>','<%= ep.name %>','<%= ep.host %>',<%= ep.port %>,'<%= ep.protocol || 'tcp' %>')">✎</button>
    <% } %>
    <form method="POST" action="/dashboard/endpoints/<%= ep._id %>/delete" class="inline-form">
      <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Eliminar endpoint?')">Eliminar</button>
    </form>
  </div>
  <% if (!ep.virtual) { %>
    <div class="mono" id="ep-addr-<%= ep._id %>"><%= ep.host %>:<%= ep.port %></div>
  <% } else { %>
    <div class="mono" style="color:var(--muted)">reverse tunnel — <span id="ep-status-<%= ep._id %>"><%= isOnline ? 'online' : 'offline' %></span></div>
  <% } %>
</div>
<% } %>
</div>

<!-- Modal editar endpoint -->
<div id="modal-ep" class="modal-overlay hidden" onclick="if(event.target===this)closeEpModal()">
  <div class="modal-box">
    <div class="row mb">
      <strong class="grow">Editar endpoint</strong>
      <button class="btn btn-ghost btn-sm" onclick="closeEpModal()">×</button>
    </div>
    <input type="hidden" id="modal-ep-id">
    <div class="form-group">
      <label>Nombre</label>
      <input id="modal-ep-name">
    </div>
    <div class="row">
      <div class="grow form-group">
        <label>Host</label>
        <input id="modal-ep-host">
      </div>
      <div class="form-group fg-w120">
        <label>Puerto</label>
        <input id="modal-ep-port" type="number">
      </div>
      <div class="form-group fg-w90">
        <label>Protocolo</label>
        <select id="modal-ep-proto">
          <option value="tcp">TCP</option>
          <option value="udp">UDP</option>
        </select>
      </div>
    </div>
    <button class="btn btn-primary btn-sm" onclick="saveEp()">Guardar</button>
  </div>
</div>

<script>
async function createEpClient() {
  const input = document.getElementById("ep-client-name");
  const name = input.value.trim();
  if (!name) return input.focus();
  try {
    const res = await fetch("/api/ep-clients", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name }),
    });
    if (!res.ok) { const e = await res.json(); throw new Error(e.error); }
    input.value = "";
    location.reload();
  } catch (e) { alert("Error: " + e.message); }
}

async function downloadEpP12(epId) {
  const password = prompt("Contraseña para el .p12 (vacío = sin contraseña):", "");
  if (password === null) return;
  try {
    const res = await fetch(`/api/ep-clients/${epId}/p12`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ password }),
    });
    if (!res.ok) { const e = await res.json(); throw new Error(e.error); }
    const blob = await res.blob();
    const cd = res.headers.get("content-disposition") || "";
    const match = cd.match(/filename=(.+)/);
    const filename = match ? match[1] : "ep-client.p12";
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = filename;
    a.click();
    URL.revokeObjectURL(a.href);
  } catch (e) { alert("Error: " + e.message); }
}

function openEditEp(id, name, host, port, protocol) {
  document.getElementById("modal-ep-id").value = id;
  document.getElementById("modal-ep-name").value = name;
  document.getElementById("modal-ep-host").value = host;
  document.getElementById("modal-ep-port").value = port;
  document.getElementById("modal-ep-proto").value = protocol || "tcp";
  document.getElementById("modal-ep").classList.remove("hidden");
}
function closeEpModal() {
  document.getElementById("modal-ep").classList.add("hidden");
}
async function saveEp() {
  const id = document.getElementById("modal-ep-id").value;
  const name = document.getElementById("modal-ep-name").value.trim();
  const host = document.getElementById("modal-ep-host").value.trim();
  const port = document.getElementById("modal-ep-port").value.trim();
  const protocol = document.getElementById("modal-ep-proto").value;
  try {
    const res = await fetch("/api/endpoints/" + id, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name, host, port: Number(port), protocol }),
    });
    if (!res.ok) throw new Error();
    document.getElementById("ep-name-" + id).textContent = name;
    document.getElementById("ep-addr-" + id).textContent = host + ":" + port;
    document.getElementById("ep-proto-" + id).textContent = protocol.toUpperCase();
    const btn = document.querySelector(`#ep-${id} .btn-ghost`);
    btn.setAttribute("onclick", `openEditEp('${id}','${name}','${host}',${port},'${protocol}')`);
    closeEpModal();
  } catch { alert("Error al guardar"); }
}

// SSE: real-time endpoint client status
const epEvt = new EventSource("/api/endpoints/events");
epEvt.onmessage = (e) => {
  try {
    const { endpointId, online } = JSON.parse(e.data);
    const dot = document.getElementById("ep-dot-" + endpointId);
    if (dot) dot.style.background = online ? "var(--success)" : "var(--border)";
    const statusEl = document.getElementById("ep-status-" + endpointId);
    if (statusEl) statusEl.textContent = online ? "online" : "offline";
  } catch {}
};
</script>
