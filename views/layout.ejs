<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bastion<%= typeof title !== 'undefined' ? ' — ' + title : '' %></title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<% if (typeof user !== 'undefined' && user) { %>
<nav class="navbar">
  <div class="container row">
    <a href="/dashboard/users" class="logo">Bastion</a>
    <div class="nav-links">
      <a href="/dashboard/users" class="nav-link<%= typeof tab !== 'undefined' && tab === 'users' ? ' active' : '' %>">Usuarios</a>
      <a href="/dashboard/endpoints" class="nav-link<%= typeof tab !== 'undefined' && tab === 'endpoints' ? ' active' : '' %>">Puntos de Acceso</a>
      <a href="/dashboard/audit" class="nav-link<%= typeof tab !== 'undefined' && tab === 'audit' ? ' active' : '' %>">Auditoría</a>
    </div>
    <form method="POST" action="/auth/logout" class="nav-logout">
      <span class="nav-user"><%= user.username %></span>
      <button type="submit" class="btn btn-danger btn-sm">Salir</button>
    </form>
  </div>
</nav>
<% } %>
<main class="container">
  <%- body %>
</main>
<% if (typeof clientScript !== 'undefined' && clientScript) { %>
<script src="<%= clientScript %>"></script>
<% } %>
</body>
</html>
